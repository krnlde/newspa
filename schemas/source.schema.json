        "kind": {
          "type": "string",
          "const": "rss"
        },
        "maxItems": {
          "default": 60,
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "id",
        "label",
        "url",
        "kind"
      ]
