              "minimum": 0,
              "maximum": 23
            }
          },
          "required": [
            "startHour",
            "endHour"
          ]
        },
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "weight": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "watchwords": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "blockwords": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "render": {
          "default": false,
          "type": "boolean"
        },
        "renderTimeoutMs": {
          "default": 20000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "profile": {
          "default": false,
