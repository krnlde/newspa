          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "timeoutMs": {
          "default": 15000,
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "maxBytes": {
          "default": 8388608,
          "type": "integer",
          "minimum": 1024,
          "maximum": 33554432
        },
        "minEditRatio": {
          "default": 0.06,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "matchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "baselinedAt": {
          "type": "string",
          "format": "date-time",
