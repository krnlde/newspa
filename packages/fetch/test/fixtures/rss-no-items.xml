<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-written fixture: a feed whose channel has a title, a lastBuildDate and
  an image, and **no item element at all**. The parser's answer must be a named
  fault that quotes the container and its children, not an empty array: "0
  items" from a feed that declares a build date is a source that changed shape,
  and rule 5 is exactly about that difference.
-->
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>No items</title>
    <link>https://example.invalid/</link>
    <description>A channel that publishes nothing.</description>
    <language>en-us</language>
    <copyright>Example</copyright>
    <lastBuildDate>Sun, 09 Nov 2025 12:00:00 GMT</lastBuildDate>
    <ttl>20</ttl>
    <image>
      <url>https://example.invalid/logo.png</url>
      <title>Example</title>
      <link>https://example.invalid/</link>
    </image>
    <atom:link href="https://example.invalid/rss.xml" rel="self" type="application/rss+xml"/>
    <docs>https://www.rssboard.org/rss-specification</docs>
    <generator>fixture-maker</generator>
  </channel>
</rss>
