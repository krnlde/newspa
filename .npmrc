# pnpm 12 reads ONLY auth / registry / TLS / proxy settings from this file.
# Behaviour rules (saveExact, minimumReleaseAge, ignoreScripts, engineStrict, ...)
# were moved to pnpm-workspace.yaml — pnpm ignores them here, with a warning.
registry=https://registry.npmjs.org/

# npm's own release-age policy, kept in sync with pnpm's minimumReleaseAge: 2880
# so the rules agree if anyone runs npm against this repo. npm's unit is DAYS.
min-release-age=2
